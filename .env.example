# ─── Config for docker-compose (copy to .env and fill in) ───

# Admin login for the detection Logs page. CHANGE THESE before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Secret used to sign JWT sessions. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12

# Where the browser reaches the backend API.
VITE_API_BASE_URL=http://localhost:8000

# Origins allowed to call the backend (CORS). Include your frontend URL(s).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
